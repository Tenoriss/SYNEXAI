# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.
# Nothing here is a secret: values stay empty on purpose. Never add a real key to
# this file, and never mirror any of these into the frontend (no VITE_* variable
# may carry an API key — the browser must not be able to call Gemini directly).

# Active AI provider. Only "gemini" is implemented today; the value is validated,
# so an unknown provider is reported as AI_PROVIDER_UNSUPPORTED instead of failing
# silently.
AI_PROVIDER=gemini

# Google Gemini API key (backend only — never exposed to the browser).
# Create it in Google AI Studio and paste it into backend/.env.
GEMINI_API_KEY=

# Gemini model used for every AI request. The model name lives only here; it is not
# hard-coded in the application. Examples that were current when this phase was
# written: gemini-2.5-flash, gemini-3.5-flash, gemini-3.6-flash, gemini-3.8-flash.
# If the account cannot see the configured model the API answers
# AI_MODEL_UNAVAILABLE — change this value, nothing else.
GEMINI_MODEL=gemini-2.5-flash

# Seconds a single AI request may take before it is reported as AI_TIMEOUT.
AI_TIMEOUT_SECONDS=120

# Extra attempts after a transient failure (rate limit, timeout, provider 5xx).
# Accepted range 0–2; invalid values fall back to the default.
AI_MAX_RETRIES=2

# Generation temperature, 0–1. Analysis restates the analyst's own input, so a
# low value keeps it faithful.
AI_TEMPERATURE=0.2

# Optional endpoint override, e.g. through a corporate proxy or a test stub.
# Leave empty for the public Gemini API.
GEMINI_BASE_URL=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production
APP_ENV=development
